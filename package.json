{
    "name": "cekcari",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "UNLICENSED",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "start": "node bin/server.js",
        "build": "node ace build",
        "dev": "node ace serve --hmr",
        "test": "node ace test",
        "test:frontend": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "imports": {
        "#controllers/*": "./app/controllers/*.js",
        "#exceptions/*": "./app/exceptions/*.js",
        "#models/*": "./app/models/*.js",
        "#services/*": "./app/services/*.js",
        "#jobs/*": "./app/jobs/*.js",
        "#middleware/*": "./app/middleware/*.js",
        "#validators/*": "./app/validators/*.js",
        "#support/*": "./app/support/*.js",
        "#database/*": "./database/*.js",
        "#tests/*": "./tests/*.js",
        "#start/*": "./start/*.js",
        "#config/*": "./config/*.js",
        "#presenters/*": "./app/presenters/*.js",
        "#generated/*": "./.adonisjs/server/*.js"
    },
    "devDependencies": {
        "@adonisjs/assembler": "^8.5.2",
        "@adonisjs/eslint-config": "^3.1.0",
        "@adonisjs/prettier-config": "^1.5.0",
        "@adonisjs/tsconfig": "^2.0.0",
        "@japa/api-client": "^3.2.1",
        "@japa/assert": "^4.2.0",
        "@japa/plugin-adonisjs": "^5.2.0",
        "@japa/runner": "^5.3.0",
        "@poppinss/ts-exec": "^1.4.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/luxon": "^3.7.5",
        "@types/node": "~26.6.2",
        "@types/qrcode": "^1.5.5",
        "@vitejs/plugin-vue": "^6.0.11",
        "eslint": "^10.11.0",
        "hot-hook": "^1.0.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.1.1",
        "youch": "^4.1.1"
    },
    "dependencies": {
        "@adonisjs/auth": "^10.1.0",
        "@adonisjs/core": "^7.5.2",
        "@adonisjs/limiter": "^3.0.1",
        "@adonisjs/lucid": "^22.4.2",
        "@adonisjs/redis": "^10.0.2",
        "@adonisjs/session": "^8.1.0",
        "@adonisjs/shield": "^9.0.0",
        "@adonisjs/static": "^2.0.1",
        "@adonisjs/vite": "^6.0.2",
        "@aws-sdk/client-s3": "^3.1156.0",
        "@tanstack/vue-table": "^9.3.1",
        "@vinejs/vine": "^4.4.0",
        "axios": "^1.21.1",
        "cheerio": "^1.2.0",
        "dayjs": "^1.11.23",
        "edge.js": "^6.5.1",
        "lucide-vue-next": "^1.0.0",
        "luxon": "^3.7.2",
        "pg": "^8.23.1",
        "pinia": "^4.1.0",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "reka-ui": "^2.11.0",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.45",
        "vue-router": "^5.5.1"
    },
    "hotHook": {
        "boundaries": [
            "./app/controllers/**/*.ts",
            "./app/middleware/*.ts"
        ]
    },
    "allowScripts": {
        "@swc/core": true,
        "esbuild": true,
        "fsevents": true
    }
}
