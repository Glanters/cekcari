APP_NAME="CekCari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Nama host tanpa skema/port. Production: isi dengan domain pencarian dan domain panel yang sebenarnya,
# lalu sesuaikan SANCTUM_STATEFUL_DOMAINS dengan domain panel.
SEARCH_DOMAIN=localhost
PANEL_DOMAIN=panel.localhost
# Alamat publik domain pencarian (untuk canonical, sitemap, Open Graph). Production: https://cekcari.com
SEARCH_URL=http://localhost:8000
# Kode verifikasi Google Search Console (opsional).
GOOGLE_SITE_VERIFICATION=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5480
DB_DATABASE=search_engine
DB_USERNAME=search_engine
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=panel.localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=search_engine_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6390

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Development memakai MinIO (docker-compose). Production: isi dengan kredensial DigitalOcean Spaces,
# AWS_ENDPOINT=https://<region>.digitaloceanspaces.com dan AWS_URL=https://<bucket>.<region>.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=search-engine
AWS_ENDPOINT=http://127.0.0.1:9110
AWS_URL=http://127.0.0.1:9110/search-engine
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_API_PORT=9110
MINIO_CONSOLE_PORT=9111

CRAWLER_MAX_PAGES=50
CRAWLER_USER_AGENT="CekCariBot/1.0"

VITE_APP_NAME="${APP_NAME}"

# Login Account Center. Production wajib http; "dummy" hanya untuk uji dan diabaikan di production.
ACCOUNTCENTER_DRIVER=http
ACCOUNTCENTER_URI=
ACCOUNTCENTER_NAME=
ACCOUNTCENTER_SECRET=
ACCOUNTCENTER_TIMEOUT_MS=8000
ACCOUNTCENTER_DUMMY_PASSWORD=
# Email superadmin awal (dipisah koma), otomatis aktif saat login pertama.
ACCOUNTCENTER_SUPERADMIN_EMAILS=

# Proxy di depan aplikasi (mis. 127.0.0.1 untuk nginx di server yang sama), dipisah koma. Wajib benar agar whitelist IP membaca IP asli.
TRUSTED_PROXIES=
