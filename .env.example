TZ=UTC
PORT=3333
HOST=127.0.0.1
LOG_LEVEL=info
APP_NAME=CekCari
APP_KEY=
NODE_ENV=development

# Domain pencarian publik dan domain panel pemilik (tanpa skema dan port).
SEARCH_DOMAIN=localhost
PANEL_DOMAIN=panel.localhost
SEARCH_URL=http://localhost:3333
GOOGLE_SITE_VERIFICATION=

SESSION_DRIVER=redis
LIMITER_STORE=redis

DB_HOST=127.0.0.1
DB_PORT=5480
DB_USER=cekcari
DB_PASSWORD=
DB_DATABASE=cekcari

REDIS_HOST=127.0.0.1
REDIS_PORT=6390
REDIS_PASSWORD=
REDIS_KEY_PREFIX=cekcari:

# Logo: MinIO di lokal, DigitalOcean Spaces di production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cekcari
AWS_ENDPOINT=http://127.0.0.1:9110
AWS_URL=http://127.0.0.1:9110/cekcari
AWS_USE_PATH_STYLE_ENDPOINT=true

CRAWLER_MAX_PAGES=50
CRAWLER_USER_AGENT="CekCariBot/1.0"
CRAWLER_DELAY_MS=500

# Login Account Center. Production wajib http; "dummy" hanya untuk uji dan diabaikan di production.
ACCOUNTCENTER_DRIVER=http
ACCOUNTCENTER_URI=
ACCOUNTCENTER_NAME=
ACCOUNTCENTER_SECRET=
ACCOUNTCENTER_TIMEOUT_MS=8000
ACCOUNTCENTER_DUMMY_PASSWORD=
# Email superadmin awal (dipisah koma), otomatis aktif saat login pertama.
ACCOUNTCENTER_SUPERADMIN_EMAILS=

# Proxy di depan aplikasi (mis. 127.0.0.1 untuk nginx di server yang sama). Jangan "*".
TRUSTED_PROXIES=